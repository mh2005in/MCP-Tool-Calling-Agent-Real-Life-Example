#!/bin/sh
# ============================================================
# post-merge: after merging work into `main` (e.g. `git pull` on
# main), remove worktrees under .claude/worktrees/ whose branch has
# landed on main, and prune the merged branch.
#
# Local convenience only - hooks are local, so nothing runs on
# GitHub's side. This fires on `git merge`/`git pull` (a real merge),
# NOT on `git pull --rebase` (no merge happens).
#
# It calls `git worktree remove` and `git branch -d` WITHOUT --force,
# so git refuses anything dirty or unmerged and this reports it
# instead of deleting it. Merged branches are detected by ancestry;
# if the repo switches to squash merges, branch commits never become
# ancestors of `main` and this cleanup stops working.
#
# Enable in a fresh clone (per-clone config):
#   git config core.hooksPath .githooks
# ============================================================
set -eu

# Only clean up when the merge landed on `main`.
current_branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null || echo "")
if [ "$current_branch" != "main" ]; then
    exit 0
fi

[ -d ".claude/worktrees" ] || exit 0

# `git worktree list --porcelain` emits, per worktree:
#   worktree <path>
#   HEAD <sha>
#   branch refs/heads/<name>   (absent for a detached worktree)
git worktree list --porcelain | awk '
    /^worktree /{ path = substr($0, 10) }
    /^branch /  { print path "\t" substr($0, 8) }
' | while IFS="$(printf '\t')" read -r path branch; do
    # Only touch worktrees under .claude/worktrees/.
    case "$path" in
        */.claude/worktrees/*) ;;
        *) continue ;;
    esac

    short_branch=${branch#refs/heads/}

    # Skip unless the branch tip is an ancestor of main (i.e. merged).
    if ! git merge-base --is-ancestor "$branch" main 2>/dev/null; then
        continue
    fi

    echo "[post-merge] '$short_branch' is merged - removing worktree: $path"
    if git worktree remove "$path" 2>/dev/null; then
        git branch -d "$short_branch" 2>/dev/null \
            || echo "[post-merge]   note: branch '$short_branch' not pruned - remove by hand if intended"
    else
        echo "[post-merge]   note: '$path' has uncommitted or leftover files - not removed; clean it up by hand"
    fi
done

exit 0

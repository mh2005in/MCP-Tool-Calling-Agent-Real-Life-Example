#!/bin/sh
# ============================================================
# pre-commit: two guards before a commit lands -
#   1. Author identity (CLAUDE.md Section 11): the commit must be
#      authored as `mh2005in`; anything else is blocked.
#   2. Secret scan (CLAUDE.md Section 8): block staged changes that
#      contain likely secrets, using gitleaks.
#
# Safety net only - it does NOT replace the placeholder rule in
# CLAUDE.md (Section 8), and gitleaks matches secret PATTERNS, not
# PII: it will not catch a real name or email for you. Bypass a
# genuine false positive with `git commit --no-verify`.
#
# Enable in a fresh clone (per-clone config):
#   git config core.hooksPath .githooks
# ============================================================
set -eu

# ------------------------------------------------------------
# 1. Author identity guard (CLAUDE.md Section 11).
# Commits must be authored as `mh2005in`. GIT_AUTHOR_IDENT is the
# effective author git will use (honours config, --author, and the
# GIT_AUTHOR_* env), formatted "Name <email> <time> <tz>"; we take
# the name (everything before " <"). This also catches an unset
# identity (empty -> mismatch). Bypass a deliberate exception with
# `git commit --no-verify`.
# ------------------------------------------------------------
expected_author="mh2005in"
author_ident=$(git var GIT_AUTHOR_IDENT 2>/dev/null || echo "")
author_name=${author_ident%% <*}
if [ "$author_name" != "$expected_author" ]; then
    echo "[pre-commit] Commit author is '${author_name:-<unset>}', expected '$expected_author' (CLAUDE.md Section 11) - commit blocked."
    echo "[pre-commit] Set it and retry:"
    echo "[pre-commit]   git config user.name '$expected_author'"
    echo "[pre-commit] Never author under another identity."
    exit 1
fi

# ------------------------------------------------------------
# 2. Secret scan (CLAUDE.md Section 8).
# ------------------------------------------------------------
if ! command -v gitleaks >/dev/null 2>&1; then
    echo "[pre-commit] gitleaks not found - skipping secret scan (install it to enable)."
    echo "[pre-commit]   Windows: winget install gitleaks   (or: scoop install gitleaks / choco install gitleaks)"
    echo "[pre-commit]   macOS:   brew install gitleaks"
    echo "[pre-commit]   See https://github.com/gitleaks/gitleaks#installing"
    exit 0
fi

echo "[pre-commit] Scanning staged changes for secrets (gitleaks)..."
if ! gitleaks git --staged --redact --no-banner; then
    echo "[pre-commit] Potential secret detected in staged changes - commit blocked."
    echo "[pre-commit] Replace real secrets with placeholders (see CLAUDE.md Section 8),"
    echo "[pre-commit] or bypass a genuine false positive with: git commit --no-verify"
    exit 1
fi

echo "[pre-commit] No secrets detected."
exit 0

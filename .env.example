# ============================================================
# Copy this file to .env and fill in real values for local runs.
# .env is gitignored - never commit real secrets.
# ============================================================

# ---- PostgreSQL (shared by the app and Keycloak) ----
POSTGRES_DB=immiauto
POSTGRES_USER=immiauto_user
POSTGRES_PASSWORD=ChangeThisStrongPassword123!

# ============================================================
# Hosts, ports & URLs — SINGLE SOURCE OF TRUTH.
# Change a domain/port here only; docker-compose derives the issuer, JWKS,
# token endpoint, CORS origin, audit URL and the SPA's runtime config from these.
# (See CLAUDE.md "Configuration & environment variables".)
# ============================================================

# ---- Published host ports (host:container) ----
POSTGRES_HOST_PORT=5435
BACKEND_HOST_PORT=8080
MCP_HOST_PORT=8084
FRONTEND_HOST_PORT=8081
KEYCLOAK_HOST_PORT=8085

# ---- Public URLs (how the BROWSER reaches each service) ----
# Must match the published host ports above; used for the token issuer, CORS,
# Keycloak redirect/web-origins, and the SPA's runtime Keycloak URL.
FRONTEND_PUBLIC_URL=http://localhost:8081
KEYCLOAK_PUBLIC_URL=http://localhost:8085

# ---- Internal URLs (service-to-service over the Docker network) ----
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
BACKEND_INTERNAL_URL=http://backend:8080

# ---- Realm, SPA client id, and the SPA's API base path ----
KC_REALM=immiauto
FRONTEND_CLIENT_ID=immiauto-frontend
API_BASE_URL=/api/v1

# ---- Keycloak admin (initial bootstrap admin) ----
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=ChangeThisAdminPassword

# ---- OIDC audiences / validation ----
OIDC_BACKEND_AUDIENCE=immiauto-backend
OIDC_AUDIENCE_VALIDATION=true
OIDC_MCP_AUDIENCE=immiauto-mcp
OIDC_MCP_AUDIENCE_VALIDATION=false
AUTO_PROVISION_CONSULTANT=true

# ---- MCP service-account client (client-credentials for audit writes) ----
MCP_CLIENT_ID=immiauto-mcp
# Must match the immiauto-mcp client secret in docker/keycloak/realm-immiauto.json.template
MCP_CLIENT_SECRET=CHANGE_ME_mcp_client_secret

# ---- Mail (optional; leave blank to disable) ----
MAIL_USERNAME=
MAIL_PASSWORD=

# ============================================================
# Copy this file to .env and fill in real values for local runs.
# .env is gitignored - never commit real secrets.
# ============================================================

# ---- PostgreSQL (shared by the app and Keycloak) ----
POSTGRES_DB=immiauto
POSTGRES_USER=immiauto_user
POSTGRES_PASSWORD=ChangeThisStrongPassword123!

# ---- Host port mappings ----
POSTGRES_HOST_PORT=5435
BACKEND_HOST_PORT=8080
MCP_HOST_PORT=8084
FRONTEND_HOST_PORT=8081
KEYCLOAK_HOST_PORT=8085

# ---- Keycloak admin (initial bootstrap admin) ----
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=ChangeThisAdminPassword
# Public base URL of Keycloak (must match how the browser reaches it, and the token issuer)
KEYCLOAK_HOSTNAME_URL=http://localhost:8085

# ---- OIDC / Keycloak (backend + MCP resource servers) ----
# issuer = public realm URL (validates token iss); jwk-set-uri = internal URL for signing keys.
OIDC_ISSUER=http://localhost:8085/realms/immiauto
OIDC_JWK_SET_URI=http://keycloak:8080/realms/immiauto/protocol/openid-connect/certs
OIDC_TOKEN_ENDPOINT=http://keycloak:8080/realms/immiauto/protocol/openid-connect/token
OIDC_BACKEND_AUDIENCE=immiauto-backend
OIDC_AUDIENCE_VALIDATION=true
OIDC_MCP_AUDIENCE=immiauto-mcp
OIDC_MCP_AUDIENCE_VALIDATION=false
AUTO_PROVISION_CONSULTANT=true

# ---- MCP service-account client (client-credentials for audit writes) ----
MCP_CLIENT_ID=immiauto-mcp
# Must match the immiauto-mcp client secret in docker/keycloak/realm-immiauto.json
MCP_CLIENT_SECRET=CHANGE_ME_mcp_client_secret

# ---- Mail (optional; leave blank to disable) ----
MAIL_USERNAME=
MAIL_PASSWORD=
